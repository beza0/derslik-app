# Yerel geliştirme örneği. Kopyalayın: cp .env.example .env  — .env repoya girmez.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://derslik:derslik_dev_only@localhost:5432/derslik
# En az 32 karakter rastgele değer üretin: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-value-at-least-32-chars
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# AI: fake (geliştirme, deterministik), anthropic (gerçek), disabled
AI_PROVIDER=fake
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Ödeme: yalnızca sandbox (test). Gerçek sağlayıcılar hesap bilgileri gelince eklenecek.
PAYMENT_PROVIDER=sandbox
PAYMENT_WEBHOOK_SECRET=dev-only-sandbox-webhook-secret

STORAGE_DIR=.uploads
# Teknik e-postalar (doğrulama, şifre sıfırlama): console | file (.mail/ klasörüne)
MAIL_MODE=console
COOKIE_SECURE=false
